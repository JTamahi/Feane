@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register";

}

<section class="sub_page">
    <div class="hero_area">
        <div class="bg-box">
            <img src="@(Url.Content("~/images/hero-bg.jpg"))" alt="">
        </div>
        <!-- header section starts -->
        @Html.Partial("_Header")
        <!-- end header section -->
    </div>

    <section class="book_section layout_padding" style="padding-top:40px;">
        <div class="container">
            <div class="heading_container">
                <h2>Register</h2>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="form_container">
                        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label for="email">Email</label>
                                <input name="email" id="email" type="email" class="form-control" placeholder="Enter email" required />
                            </div>
                            <div class="form-group">
                                <label for="password">Password</label>
                                <input name="password" id="password" type="password" class="form-control" placeholder="Enter password" required />
                            </div>
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="text-danger">
                                    @foreach (var m in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <div>@m.ErrorMessage</div>
                                    }
                                </div>
                            }
                            <div class="btn_box d-flex justify-content-between">
                                <button type="submit" class="btn btn-primary">Register</button>
                                <div>
                                    <a class="btn btn-link" href="@Url.Action("Login", "Account")">Back to Login</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</section>
