@{
}

@using System
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@functions {
    private string CurrentController => ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    private string CurrentAction => ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    private string IsActive(string controller, string action = null)
    {
        if (string.IsNullOrEmpty(controller)) return string.Empty;
        bool controllerMatch = string.Equals(CurrentController, controller, System.StringComparison.OrdinalIgnoreCase);
        if (action == null) return controllerMatch ? "active" : string.Empty;
        bool actionMatch = string.Equals(CurrentAction, action, System.StringComparison.OrdinalIgnoreCase);
        return controllerMatch && actionMatch ? "active" : string.Empty;
    }
}

<!-- header section strats -->
<header class="header_section">
    <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
            <a class="navbar-brand" href="@Url.Action("Index","Home")">
                <span>Feane</span>
            </a>

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
                <span class=""> </span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item @(IsActive("Home","Index"))">
                        <a class="nav-link" href="@Url.Action("Index","Home")">@Localizer["Home"]</a>
                    </li>
                    <li class="nav-item @(IsActive("Menu","Menu"))">
                        <a class="nav-link" href="@Url.Action("Menu","Menu")">@Localizer["Menu"]</a>
                    </li>
                    <li class="nav-item @(IsActive("About","About"))">
                        <a class="nav-link" href="@Url.Action("About","About")">@Localizer["About"]</a>
                    </li>
                    <li class="nav-item @(IsActive("Book","Book"))">
                        <a class="nav-link" href="@Url.Action("Book","Book")">@Localizer["BookTable"]</a>
                    </li>
                </ul>

                <div class="user_option">
                    <!-- restored user link -->
                    <a href="@Url.Action("LogInOut","Account")" class="user_link @(User?.Identity?.IsAuthenticated == true ? "active" : "")">
                        <i class="fa fa-user" aria-hidden="true"></i>
                    </a>

                    <!-- language switch (cookie + redirect back) -->
                    @{
                        var returnUrl = Context.Request.Path + Context.Request.QueryString;
                        var current = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName;
                    }
                    <div class="lang-switch">
                        <a class="lang-link @(current == "ru" ? "active" : "")"
                           href="@Url.Action("Set","Culture", new { culture = "ru", returnUrl = returnUrl })">RU</a>
                        &nbsp;|&nbsp;
                        <a class="lang-link @(current == "en" ? "active" : "")"
                           href="@Url.Action("Set","Culture", new { culture = "en", returnUrl = returnUrl })">EN</a>
                    </div>

                    <!-- restored cart, search & order buttons -->
                    <a class="cart_link" href="#">
                        <!-- оставлено svg -->
                    </a>
                    <form class="form-inline">
                        <button class="btn my-2 my-sm-0 nav_search-btn" type="submit">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>
                    </form>
                    <a href="#" class="order_online">@Localizer["OrderOnline"]</a>
                </div>
            </div>
        </nav>
    </div>
</header>
<!-- end header section -->