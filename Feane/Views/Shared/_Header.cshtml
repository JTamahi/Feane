@using System
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var userCookie = Context.Request.Cookies["FeaneUser"];
}

@functions {
    private string CurrentController => ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    private string CurrentAction => ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    private string CurrentPage => ViewContext.RouteData.Values["page"]?.ToString() ?? ViewContext.HttpContext.Request.Path.ToString();

    private string IsActive(string controller, string action = null)
    {
        if (string.IsNullOrEmpty(controller)) return string.Empty;
        bool controllerMatch = string.Equals(CurrentController, controller, StringComparison.OrdinalIgnoreCase);
        if (action == null) return controllerMatch ? "active" : string.Empty;
        bool actionMatch = string.Equals(CurrentAction, action, StringComparison.OrdinalIgnoreCase);
        return controllerMatch && actionMatch ? "active" : string.Empty;
    }

    private string IsActivePage(string pagePath)
    {
        if (string.IsNullOrEmpty(pagePath)) return string.Empty;
        return string.Equals(CurrentPage, pagePath, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }
}

<!-- header section strats -->
<header class="header_section">
    <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <span>
                    Feane
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class=""> </span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item @(IsActive("Home","Index"))">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">@Localizer["Nav_Home"]</a>
                    </li>
                    <li class="nav-item @(IsActive("Menu","Menu"))">
                        <a class="nav-link" href="@Url.Action("Menu", "Menu")">@Localizer["Nav_Menu"]</a>
                    </li>
                    <li class="nav-item @(IsActive("About","About"))">
                        <a class="nav-link" href="@Url.Action("About", "About")">@Localizer["Nav_About"]</a>
                    </li>
                    <li class="nav-item @(IsActive("Book","Book"))">
                        <a class="nav-link" href="@Url.Action("Book", "Book")">@Localizer["Nav_BookTable"]</a>
                    </li>
                </ul>
                <div class="user_option">
                    @if (!string.IsNullOrEmpty(userCookie))
                    {
                        <a href="@Url.Action("Logout", "Account")" class="user_link">
                            <i class="fa fa-user" aria-hidden="true"></i>
                            <span style="margin-left:6px;">@userCookie | LogOut</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path + Context.Request.QueryString })" class="user_link">
                            <i class="fa fa-user" aria-hidden="true"></i>
                        </a>
                    }

                    <!-- language switch buttons -->
                    <a class="btn btn-link language-link" href="@Url.Action("SetLanguage", "Culture", new { culture = "en", returnUrl = Context.Request.Path + Context.Request.QueryString })">EN</a>
                    <a class="btn btn-link language-link" href="@Url.Action("SetLanguage", "Culture", new { culture = "ru", returnUrl = Context.Request.Path + Context.Request.QueryString })">RU</a>
                </div>
            </div>
        </nav>
    </div>
</header>
<!-- end header section -->