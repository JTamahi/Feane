@{
    Layout = null;
    var code = (int)(ViewBag.Code ?? 0);
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" type="text/css" href="@(Url.Content("~/css/bootstrap.css"))" />
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" crossorigin="anonymous" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <section class="container" style="padding:40px 0;">
        <h1>@code</h1>
        <p>
            @(code == 404 ? "Page not found." : "Request cannot be processed.")
        </p>
        <a class="btn btn-primary" href="/">Go to Home</a>
    </section>
</body>
</html>
