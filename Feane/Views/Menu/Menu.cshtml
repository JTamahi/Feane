@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Menu"];
}

<section class="sub_page">
	<div class="hero_area">
		<div class="bg-box">
			<img src="@(Url.Content("~/images/hero-bg.jpg"))" alt="">
