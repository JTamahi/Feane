@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["About"];
}

<section class="sub_page">
	<div class="hero_area">
		<div class="bg-box">
			<img src="@(Url.Content("~/images/hero-bg.jpg"))" alt="">
		</div>
		<!-- header section strats -->
		@Html.Partial("_Header")
		<!-- end header section -->
	</div>

	<!-- about section -->

	<section class="about_section layout_padding">
		<div class="container  ">

			<div class="row">
				<div class="col-md-6 ">
					<div class="img-box">
						<img src="@(Url.Content("~/images/about-img.png"))" alt="">
					</div>
				</div>
				<div class="col-md-6">
					<div class="detail-box">
						<div class="heading_container">
							<h2>
								@Localizer["WeAreFeane"]
							</h2>
						</div>
						<p>
							@Localizer["AboutParagraph"]
						</p>
						<a href="#">
							@Localizer["ReadMore"]
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- end about section -->

</section>

