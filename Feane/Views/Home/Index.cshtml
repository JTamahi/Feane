                        <div class="row">
                            <div class="col-md-7 col-lg-6 ">
                                <div class="detail-box">
                                    <h1>
                                        @Localizer["Hero_FastFoodTitle"]
                                    </h1>
                                    <p>
                                        @Localizer["Hero_Paragraph1"]
                                    </p>
                                    <div class="btn-box">
                                        <a href="@Url.Action("Book", "Book")" class="btn1">
