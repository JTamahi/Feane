@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Home"];
}

<div class="hero_area">
    <div class="bg-box">
        <img src="@(Url.Content("~/images/hero-bg.jpg"))" alt="">
    </div>

    @Html.Partial("_Header")

    <section class="slider_section ">
        <div id="customCarousel1" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="container ">
                        <div class="row">
                            <div class="col-md-7 col-lg-6 ">
                                <div class="detail-box">
                                    <h1>@Localizer["FastFoodHeading"]</h1>
                                    <p>@Localizer["FastFoodText"]</p>
                                    <div class="btn-box">
                                        <a href="#" class="btn1">@Localizer["OrderNow"]</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="carousel-item ">
                    <div class="container ">
                        <div class="row">
                            <div class="col-md-7 col-lg-6 ">
                                <div class="detail-box">
                                    <h1>@Localizer["FastFoodHeading"]</h1>
                                    <p>@Localizer["FastFoodText2"]</p>
                                    <div class="btn-box">
                                        <a href="#" class="btn1">@Localizer["OrderNow"]</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>
</div>

<section class="offer_section layout_padding-bottom">
    <div class="offer_container">
        <div class="container ">
            <div class="row">
                <div class="col-md-6  ">
                    <div class="box ">
                        <div class="img-box"><img src="@(Url.Content("~/images/o1.jpg"))" alt=""></div>
                        <div class="detail-box">
                            <h5>@Localizer["TastyThursdays"]</h5>
                            <h6><span>20%</span> @Localizer["Off"]</h6>
                            <a href="#">@Localizer["OrderNow"]</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6  ">
                    <div class="box ">
                        <div class="img-box"><img src="@(Url.Content("~/images/o2.jpg"))" alt=""></div>
                        <div class="detail-box">
                            <h5>@Localizer["PizzaDays"]</h5>
                            <h6><span>15%</span> @Localizer["Off"]</h6>
                            <a href="#">@Localizer["OrderNow"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>