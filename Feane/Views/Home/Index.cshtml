<!-- food section -->

<section class="food_section layout_padding-bottom">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>
                @Localizer["Menu_OurMenu"]
            </h2>
        </div>

        <ul class="filters_menu">
            <li class="active" data-filter="*">@Localizer["Filter_All"]</li>
            <li data-filter=".burger">@Localizer["Filter_Burger"]</li>
            <li data-filter=".pizza">@Localizer["Filter_Pizza"]</li>
            <li data-filter=".pasta">@Localizer["Filter_Pasta"]</li>
            <li data-filter=".fries">@Localizer["Filter_Fries"]</li>
        </ul>

        <div class="filters-content">
			<div class="row grid">
			    @foreach (var product in Model)
				{
					<div class="col-sm-6 col-lg-4 all @product.Category">
